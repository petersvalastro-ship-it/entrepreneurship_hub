     <div class="small-card space-y-4">
      <h4 data-template-id="participant-a" class="canva-text font-bold text-[#61249a]" data-canva-font-size="1rem" style="white-space: pre-wrap !important; overflow-wrap: normal !important; line-height: normal !important; color: rgb(97, 36, 154) !important; --canva-color: #61249aff; caret-color: rgb(97, 36, 154) !important;  font-weight: 700 !important; font-style: normal !important; font-size: 17px;">Participant A</h4>
