export default function EntrepreneurshipApp({ initialTab = 'dashboard' }: { initialTab?: string } = {}) {
  // Navigation & UI state
  const [activeTab, setActiveTab] = useState(initialTab);
  const allAssignments = useAssignments();
  useEffect(() => { if (typeof window === 'undefined') return; const p = window.location.pathname; const map = { casestudies: '/learning/case-studies', syllabus: '/learning/syllabus', assignments: '/learning/assignments', ...Object.fromEntries(allAssignments.entries.map((e) => [e.tab, e.path])) } as Record<string, string>; 