          <label><input type="radio" name="peer_test_p1_solved" value="Yes" required>Yes</label><label><input type="radio" name="peer_test_p1_solved" value="Not yet">Not yet</label>
         </div>
        </fieldset>
        <fieldset class="puzzle pink">
         <legend data-template-id="test-p2-heading" style="font-size:15.9995px