e !important; }
      .no-print { display:none !important; }
      .page-width { width:100%; }
      .sheet { box-shadow:none; border-color:#bbb; break-inside:avoid; margin-bottom:12px !important; }
      .hero-image { max-height:190px; }
      .response { min-height:64px; }
      .response.short { min-height:46px; }
      main { padding-top:12px !important; }
      @page { margin:14mm; }
    }
  </style>
