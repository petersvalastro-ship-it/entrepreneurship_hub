    .route-dot { position:absolute; top:-6px; left:0; width:10px; height:10px; border:2px solid #f6bfd8; border-radius:50%; background:#251936; }
    .route-label, .route-time { display:block; line-height:1.25; }
    .route-label { color:#fff; font-size:.86rem; }
    .route-time { margin-top:5px; color:#eadcf0; font-size:.75rem; }
    @media (max-width:700px) { .route-timeline { grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:18px; } .route-step:not(:last-child)::after { display:none; } }
    .reading strong { color:var(--purple); }
    .choice { display:flex; align-items:center; gap:10px; padding:12px 14px; border:1px solid var(--line); border-radius:4px; cursor:pointer; background:white; }
    .choice:has(input:checked) { border-color:var(--purple); background:#f5edf9; }
    input[type=radio] { accent-color:var(--purple); width:17px; height:17px; flex:none; }
    .small-card { border:1px solid var(--line); border-radius:4px; background:white; padding:19px; }
    textarea:focus-visible, button:focus-visible, a:focus-visible, input:focus-visible { outline:3px solid #e994bb; outline-offset:2px; }
    .hero-graphic { position:relative; aspect-ratio:1.27; overflow:hidden; border-radius:24px; background:linear-gradient(145deg,#fff7fc 0%,#ead8f4 100%); border:1px solid #ead7ef; }
    .hero-graphic::before { content:""; position:absolute; width:58%; height:58%; right:-8%; top:-12%; border-radius:50%; background:#f6bfd8; opacity:.7; }
    .hero-graphic::after { content:""; position:absolute; width:44%; height:44%; left:-10%; bottom:-13%; border-radius:50%; background:#bfa0d9; opacity:.55; }
    .hero-graphic-art { position:absolute; inset:12%; z-index:1; }
    .hero-graphic-card { position:absolute; inset:9% 7%; border:3px solid #61249a; border-radius:18px; background:#fffdfb; transform:rotate(-3deg); box-shadow:10px 12px 0 #d9c4e5; }
    .hero-graphic-card::before { content:""; position:absolute; left:12%; right:12%; top:18%; height:12px; border-radius:8px; background:#cc2474; box-shadow:0 30px 0 #eadff0, 0 60px 0 #eadff0; }
    .hero-graphic-card::after { content:"?"; position:absolute; right:12%; bottom:13%; width:54px; height:54px; display:grid; place-items:center; border-radius:50%; background:#61249a; color:#fff; font:700 32px Fraunces,serif; }
    .hero-graphic-people { position:absolute; left:12%; right:12%; bottom:12%; height:33%; display:flex; justify-content:space-around; align-items:end; }
    .hero-graphic-person { position:relative; width:22%; height:78%; border-radius:48% 48% 18% 18%; background:#61249a; }
    .hero-graphic-person::before { content:""; position:absolute; width:58%; aspect-ratio:1; left:21%; top:-42%; border-radius:50%; background:#f1a87e; border:3px solid #241c30; }
    .hero-graphic-person:nth-child(2) { height:100%; background:#cc2474; }
    .hero-graphic-person:nth-child(3) { height:66%; background:#d4492b; }
    @media print { .hero-graphic { max-height:190px; } }
