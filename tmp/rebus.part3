color:rgb(255, 255, 255)" class="canva-text hidden">Submitting…</span></button><button type="button" class="print-btn ml-3">🖨️ Print / Save as PDF</button>
       <div id="form-message" role="status" aria-live="polite" class="hidden mt-4"></div>
      </section>
     </form>
     <footer class="border-t border-gray-200 mt-12 pt-6 text-center">
      <p data-template-id="footer-line" style="font-size:15.9995px;font-weight:700;color:rgb(100, 33, 154)" class="canva-text eyebrow">✦ CREATE  •  TEST  •  REVISE ✦</p>
     </footer>
    </div>
   </main>
  </div>
  <script>
window.dataSdk={K:'neia_rebus_studio',
 all(){try{return JSON.parse(localStorage.getItem(this.K)||'[]')}catch(e){return[]}},
 async init(h){this.h=h;return{isOk:true}},
 async create(r){try{const a=this.all();a.push(r);localStorage.setItem(this.K,JSON.stringify(a));return{isOk:true}}catch(e){return{isOk:false}}}};
</script>
  <script>
  lucide.createIcons();
  const form = document.getElementById('assignment-form');
  const button = document.getElementById('submit-button');
  document.querySelectorAll('.print-btn').forEach(btn => btn.addEventListener('click', () => window.print()));
  const message = document.getElementById('form-message');
  const readyLabel = document.querySelector('[data-template-id="submit-label"]');
  const pendingLabel = document.querySelector('[data-template-id="submitting-label"]');
  let sdkReady = false;

  function showMessage(text, kind) {
    message.textContent = text;
    message.className = 'message ' + kind + ' mt-4';
  }
  function setPending(pending) {
    button.disabled = pending;
    readyLabel.classList.toggle('hidden', pending);
    pendingLabel.classList.toggle('hidden', !pending);
  }
  async function initialize() {
    try {
      const result = await window.dataSdk.init({onDataChanged() {}});
      sdkReady = result.isOk;
      if (!sdkReady) showMessage('The assignment could not connect to the assignment. Keep this page open and try again later.', 'error');
    } catch (_) {
      sdkReady = false;
      showMessage('The assignment could not connect to the assignment. Keep this page open and try again later.', 'error');
    }
  }
  initialize();

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (button.disabled) return;
    const invalid = [...form.elements].find(el => el.willValidate && !el.checkValidity());
    if (invalid) {
      if (document.getElementById('answer-key').contains(invalid)) document.getElementById('answer-key').open = true;
      invalid.focus();
      showMessage('Complete all response fields and choose Yes or Not yet for each puzzle.', 'error');
      return;
    }
    if (!document.getElementById('revision-check').checked) {
      document.getElementById('revision-check').focus();
      showMessage('Revise at least one puzzle and check the revision item before submitting.', 'error');
      return;
    }
    if (!sdkReady) {
      showMessage('The assignment is not connected. Your entries remain on this page; please try again.', 'error');
      await initialize();
      return;
    }
    const fields = [
      'student_name','qotd_response','case_q1','case_q2','case_q3','case_q4',
      'puzzle1_answer','puzzle1_clue','puzzle2_answer','puzzle2_clue','puzzle3_answer','puzzle3_clue',
      'peer_test_p1_guess','peer_test_p1_hesitation','peer_test_p1_solved',
      'peer_test_p2_guess','peer_test_p2_hesitation','peer_test_p2_solved',
      'peer_test_p3_guess','peer_test_p3_hesitation','peer_test_p3_solved',
      'revision_note','exit_ticket_1','exit_ticket_2'
    ];
    const values = new FormData(form);
    const record = Object.fromEntries(fields.map(key => [key, String(values.get(key) || '').trim()]));
    record.submitted_at = new Date().toISOString();
    setPending(true);
    try {
      const result = await window.dataSdk.create(record);
      if (result.isOk) { showMessage('Choose "Save as PDF" in the print window, then email the PDF to pietro.valastro@neiacademy.org.', 'success'); setTimeout(()=>window.print(),300); }
      else showMessage('We could not confirm your submission. Your entries are still here. Check with your teacher before submitting again.', 'error');
    } catch (_) {
      showMessage('We could not confirm your submission. Your entries are still here. Check with your teacher before submitting again.', 'error');
    } finally {
      setPending(false);
    }
  });
</script>
 </body>
</html>