s="section" aria-labelledby="finish-heading">
       <div class="section-title">
        <span class="icon-badge" aria-hidden="true"><i data-lucide="circle-check-big"></i></span>
        <h2 id="finish-heading" data-template-id="finish-heading" style="font-size:23.9993px;font-weight:700;color:rgb(23, 23, 23)" class="canva-text">Final Check</h2>
       </div>
       <div data-template-id="check-panel" class="canva-panel panel space-y-3 mb-7"><label class="check-row"><input type="checkbox"><span data-template-id="check-one" style="font-size:15.9995px;font-weight:400;color:rgb(36, 36, 36)" class="canva-text">I created three original puzzles in three different categories.</span></label> <label class="check-row"><input type="checkbox"><span data-template-id="check-two" style="font-size:15.9995px;font-weight:400;color:rgb(36, 36, 36)" class="canva-text">I included an answer and key-clue explanation for each puzzle.</span></label> <label class="check-row"><input id="revision-check" type="checkbox"><span data-template-id="check-three" style="font-size:15.9995px;font-weight:400;color:rgb(36, 36, 36)" class="canva-text">I recorded peer-test evidence and revised at least one puzzle.</span></label> <label class="check-row"><input type="checkbox"><span data-template-id="check-four" style="font-size:15.9995px;font-weight:400;color:rgb(36, 36, 36)" class="canva-text">My work is readable, respectful, and ready for classmates to solve.</span></label>
       </div>
       <h3 data-template-id="exit-heading" style="font-size:18.9995px;font-weight:700;color:rgb(23, 23, 23)" class="canva-text mb-4">Exit Ticket</h3>
       <div class="space-y-5">
